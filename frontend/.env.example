# Copy to .env and adjust. Every value below is optional.

# --- Backend location -------------------------------------------------------
# Where the dev server proxies /api to.
VITE_API_URL=http://localhost:8000
# Set to true if the backend routes have NO /api prefix (POST /documents instead of /api/documents).
VITE_PROXY_STRIP_API=false
# Base path the browser calls. Leave as /api to use the proxy above.
VITE_API_BASE_URL=/api

# --- Endpoint paths (relative to the base). Empty = "not connected yet" in the UI. ---
# CONFIRM WITH SARTHAK: login path, chat path, document list, chat history.
VITE_AUTH_LOGIN_PATH=
VITE_DOCUMENTS_UPLOAD_PATH=/documents
VITE_DOCUMENTS_LIST_PATH=
VITE_CHAT_PATH=/query
VITE_CONVERSATIONS_PATH=
VITE_CONVERSATION_PATH=

# --- Development helpers ----------------------------------------------------
# Shows "Enter as student/admin" buttons on the login page so you can see the screens without a backend.
# Only works with `npm run dev`; ignored in production builds. API calls then carry no token.
VITE_DEV_LOGIN=true
# Shows pages outside the immediate MVP (tickets, answer review, analytics, platform console). They use demo data.
VITE_ENABLE_FUTURE_PAGES=false
